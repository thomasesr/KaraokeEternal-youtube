# syntax=docker/dockerfile:1.6
#
# GPU variant — requires NVIDIA Container Toolkit on the host and --gpus all at runtime.
#
# Layer caching strategy:
#   deps  — nvidia/cuda base + apt + Node (NodeSource) + pip + Deno.
#           Rebuilds only when requirements.txt or init.sh changes.
#           Code commits never touch this layer.
#   builder/installer — npm build + prod node_modules (rebuilt per commit).
#   runtime — FROM deps; just copies app artifacts on top.
#
# Build:
#   docker build -f Dockerfile-cuda .
#   docker build -f Dockerfile-cuda github.com/thomasesr/KaraokeEternal-youtube#merge
# Run:
#   docker run --gpus all ...

# ---- deps ----
# Heavy, stable layer: CUDA base + system packages + Node + Python deps + Deno.
# init.sh --install-gpu detects Node already on PATH (NodeSource) and skips nvm.
FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04 AS deps

# System packages (apt)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ffmpeg ca-certificates zip unzip curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Node 24 via NodeSource — system-wide, no nvm needed
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# node user — matches UID/GID 1000 used by official node images
RUN groupadd --gid 1000 node \
    && useradd --uid 1000 --gid node --shell /bin/bash --create-home node

# Python deps (tensorflow[and-cuda], spleeter, yt-dlp, ctc-forced-aligner) + Deno.
# Cached as long as requirements.txt and init.sh are unchanged — even across code commits.
COPY requirements.txt init.sh /tmp/
RUN bash /tmp/init.sh --install-gpu

# ---- builder ----
# Node 24 on Alpine for npm ci + build (node-gyp only needs any python3)
FROM node:24-alpine AS builder

ARG REPO_SLUG=thomasesr/KaraokeEternal-youtube
ARG REPO_BRANCH=merge

RUN apk add --no-cache git python3 make g++ pkgconfig

WORKDIR /src

ADD https://api.github.com/repos/${REPO_SLUG}/commits/${REPO_BRANCH} /tmp/branch-head.json
RUN git clone --depth=1 --branch "${REPO_BRANCH}" "https://github.com/${REPO_SLUG}.git" .

RUN npm ci
RUN npm run build

# ---- installer ----
# Fresh npm ci --omit=dev is faster than npm prune on large trees
FROM node:24-alpine AS installer
RUN apk add --no-cache python3 make g++ pkgconfig
WORKDIR /prod-deps
COPY --from=builder /src/package.json /src/package-lock.json ./
RUN npm ci --omit=dev

# ---- runtime ----
# Inherits nvidia/cuda base + all Python/Node/Deno deps from deps stage.
FROM deps

# TF_FORCE_GPU_ALLOW_GROWTH: prevent TensorFlow from pre-allocating all VRAM.
ENV NODE_ENV=production \
    KES_PATH_DATA=/data \
    KES_PORT=3000 \
    SPLEETER_DATA=/data/spleeter \
    TF_FORCE_GPU_ALLOW_GROWTH=true \
    CTC_USE_GPU=1 \
    CTC_MODEL_PATH=/data/ctc

WORKDIR /app

COPY --from=builder --chown=node:node /src/build ./build
COPY --from=builder --chown=node:node /src/assets ./assets
COPY --from=installer --chown=node:node /prod-deps/node_modules ./node_modules
COPY --from=builder --chown=node:node /src/package.json ./package.json
COPY --from=builder --chown=node:node /src/init.sh ./init.sh
COPY --from=builder --chown=node:node /src/requirements.txt ./requirements.txt
RUN chmod +x /app/init.sh

RUN mkdir -p /data && chown node:node /data

VOLUME ["/data"]

EXPOSE 3000

USER node

ENTRYPOINT ["/app/init.sh"]
