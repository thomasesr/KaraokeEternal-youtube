# Copy this file to .env and fill in values

# --- YouTube ---
KES_YOUTUBE_API_KEY=

# --- LRC enhancement backend ---
# By default CTC is used (http://ctc:5001 is always started).
# To use whisperx instead:
#   1. Start with: docker compose --profile whisperx up
#   2. Set WHISPERX_SERVICE_URL below (whisperx wins over ctc when set)
WHISPERX_SERVICE_URL=

# --- Spleeter model ---
# SPLEETER_MODEL=2stems   (options: 2stems, 2stems-finetune)

# --- Port ---
# KES_PORT=3000

# --- Logging ---
# LOG_LEVEL=info   (off|error|warn|info|verbose|debug)
