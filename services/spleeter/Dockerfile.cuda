# GPU variant — requires NVIDIA Container Toolkit on the host.
# CUDA+cuDNN provided by the base image; TensorFlow auto-detects the GPU.
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip curl ca-certificates && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt

COPY app.py entrypoint.sh ./
RUN chmod +x entrypoint.sh

ENV SPLEETER_DATA=/data/spleeter \
    SPLEETER_MODEL=2stems \
    SPLEETER_USE_GPU=1 \
    TF_FORCE_GPU_ALLOW_GROWTH=true

VOLUME ["/data", "/shared-tmp"]
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" || exit 1
ENTRYPOINT ["./entrypoint.sh"]
